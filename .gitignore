# ==========================================
# CareConnect AI - Root .gitignore
# ==========================================

# 1. Environment & Sensitive Secrets
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.pem
*.key
*.cert
*.pfx
*.p12

# Explicitly preserve template / example environment files
!.env.example
!server/.env.example
!client/.env.example

# 2. Dependencies
node_modules/
client/node_modules/
server/node_modules/

# 3. Build & Distribution Outputs
dist/
dist-ssr/
client/dist/
build/
client/build/
server/build/
.output/

# 4. User Uploads & Media (Preserve folder structure via .gitkeep)
server/uploads/*
!server/uploads/.gitkeep


# 5. Testing & Coverage
coverage/
client/coverage/
server/coverage/
.nyc_output/
*.lcov

# 6. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. Operating System & Cache Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.cache/
.parcel-cache/
.eslintcache

# 8. IDE & Editor Configuration
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# 9. Local Agent / Scratch Files
.system_generated/
scratch/
